generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessRole {
  OWNER
  ADMIN
  STAFF
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  RECEIPT_ACCEPTED
  NEEDS_ATTENTION
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  displayName  String
  passwordHash String?
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Business {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  branches    Branch[]
  memberships Membership[]
  bookings    Booking[]
  customers   Customer[]
  payments    Payment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Branch {
  id                     String                 @id @default(cuid())
  businessId             String
  name                   String
  slug                   String
  timeZone               String                 @default("Asia/Dushanbe")
  recipientCardEncrypted String?
  recipientCardLast4     String?
  business               Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services               Service[]
  resources              Resource[]
  scheduleRules          BusinessScheduleRule[]
  staffMembers           StaffMember[]
  bookings               Booking[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([businessId, slug])
  @@index([businessId])
}

model Membership {
  id         String       @id @default(cuid())
  businessId String
  userId     String
  role       BusinessRole
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  staff      StaffMember?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([businessId, userId])
  @@index([userId])
}

model StaffMember {
  id           String     @id @default(cuid())
  branchId     String
  membershipId String     @unique
  displayName  String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  services     Service[]
  bookings     Booking[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([branchId])
}

model Service {
  id              String            @id @default(cuid())
  branchId        String
  name            String
  durationMinutes Int
  amountDiram     Int
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffMembers    StaffMember[]
  resources       ServiceResource[]
  bookings        Booking[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([branchId])
}

model Resource {
  id        String            @id @default(cuid())
  branchId  String
  name      String
  branch    Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  services  ServiceResource[]
  bookings  BookingResource[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([branchId])
}

model Booking {
  id         String            @id @default(cuid())
  businessId String
  branchId   String
  serviceId  String
  staffId    String
  customerId String
  startsAt   DateTime
  endsAt     DateTime
  expiresAt  DateTime
  status     BookingStatus     @default(PENDING_PAYMENT)
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch     Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service    Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff      StaffMember       @relation(fields: [staffId], references: [id], onDelete: Restrict)
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  resources  BookingResource[]
  payment    Payment?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([businessId, branchId, startsAt, endsAt])
  @@index([staffId, startsAt, endsAt])
  @@index([status, expiresAt])
}

model Customer {
  id         String    @id @default(cuid())
  businessId String
  name       String
  phone      String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings   Booking[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, phone])
  @@index([businessId])
}

model Payment {
  id                  String        @id @default(cuid())
  businessId          String
  bookingId           String        @unique
  amountDiram         Int
  status              PaymentStatus @default(PENDING)
  operationNumber     String?
  receiptAmountDiram  Int?
  recipientCardSuffix String?
  operationAt         DateTime?
  receiptStorageKey   String?
  receiptAcceptedAt   DateTime?
  isBankVerified      Boolean       @default(false)
  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking             Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([businessId, operationNumber])
  @@index([businessId, status])
}

model BookingResource {
  bookingId  String
  resourceId String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@id([bookingId, resourceId])
  @@index([resourceId])
}

model ServiceResource {
  serviceId  String
  resourceId String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([serviceId, resourceId])
  @@index([resourceId])
}

model BusinessScheduleRule {
  id        String   @id @default(cuid())
  branchId  String
  dayOfWeek Int
  startsAt  String
  endsAt    String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, dayOfWeek])
}
