generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessRole {
  OWNER
  ADMIN
  STAFF
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum BookingSource {
  WEB
  TELEGRAM
  DASHBOARD
}

enum PaymentStatus {
  PENDING
  RECEIPT_PROCESSING
  RECEIPT_ACCEPTED
  NEEDS_ATTENTION
  REJECTED
}

enum ReceiptSubmissionStatus {
  UPLOADED
  PROCESSING
  ACCEPTED
  NEEDS_REVIEW
  REJECTED
  FAILED
}

enum MessageChannel {
  TELEGRAM
  WHATSAPP
  SMS
}

enum SubscriptionPlan {
  START
  STANDARD
  PREMIUM
}

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum BookingSeriesStatus {
  ACTIVE
  CANCELLED
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  CONVERTED
  CANCELLED
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

enum MessageStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum TelegramIntegrationStatus {
  PENDING
  ACTIVE
  ERROR
  DISCONNECTED
}

enum TelegramConnectionMethod {
  TOKEN
  MANAGED
}

enum ManagedBotConnectionStatus {
  PENDING
  PROCESSING
  COMPLETED
  EXPIRED
  FAILED
}

enum TelegramChatType {
  PRIVATE
  GROUP
  SUPERGROUP
  CHANNEL
}

enum ConversationStatus {
  ACTIVE
  WAITING_FOR_OPERATOR
  CLOSED
}

enum ConversationChannel {
  TELEGRAM
  WHATSAPP
  WEB
}

enum InboundUpdateStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                            String                        @id @default(cuid())
  email                         String?                       @unique
  phone                         String?                       @unique
  displayName                   String
  passwordHash                  String?
  isPlatformAdmin               Boolean                       @default(false)
  memberships                   Membership[]
  connectedTelegramIntegrations BusinessTelegramIntegration[] @relation("TelegramIntegrationConnector")
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

model Business {
  id                               String                        @id @default(cuid())
  status                           BusinessStatus                @default(ACTIVE)
  name                             String
  slug                             String                        @unique
  branches                         Branch[]
  memberships                      Membership[]
  staffMembers                     StaffMember[]
  bookings                         Booking[]
  customers                        Customer[]
  payments                         Payment[]
  receiptSubmissions               ReceiptSubmission[]
  messages                         Message[]
  businessNotifications            BusinessNotification[]
  auditEvents                      AuditEvent[]
  telegramIntegrations             BusinessTelegramIntegration[]
  managedBotConnectionIntents      ManagedBotConnectionIntent[]
  conversations                    Conversation[]
  conversationActions              ConversationAction[]
  whatsappPhoneNumberId            String?
  whatsappTemplateName             String?
  whatsappConfirmationTemplateName String?
  whatsappCancellationTemplateName String?
  whatsappLanguageCode             String                        @default("ru")
  logoStorageKey                   String?
  brandColor                       String?
  notifyOnNewBooking               Boolean                       @default(true)
  notifyOnPaymentNeedsReview       Boolean                       @default(true)
  notifyOnCancellation             Boolean                       @default(true)
  cancellationPolicy               String?
  subscriptionPlan                 SubscriptionPlan              @default(START)
  smsNotificationsEnabled          Boolean                       @default(false)
  defaultCommissionPercent         Int?
  publicPageLocale                 String                        @default("ru")
  bookingSeries                    BookingSeries[]
  waitlistEntries                  WaitlistEntry[]
  commissionEntries                CommissionEntry[]
  reviews                          Review[]
  promoCodes                       PromoCode[]
  createdAt                        DateTime                      @default(now())
  updatedAt                        DateTime                      @updatedAt
}

model Branch {
  id                     String                 @id @default(cuid())
  businessId             String
  name                   String
  slug                   String
  address                String?
  phone                  String?
  timeZone               String                 @default("Asia/Dushanbe")
  recipientCardEncrypted String?
  recipientCardLast4     String?
  business               Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services               Service[]
  resources              Resource[]
  scheduleRules          BusinessScheduleRule[]
  staffAssignments       StaffBranch[]
  staffScheduleRules     StaffScheduleRule[]
  scheduleBreaks         ScheduleBreak[]
  scheduleExceptions     ScheduleException[]
  bookings               Booking[]
  archivedAt             DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([businessId, slug])
  @@index([businessId])
}

model Membership {
  id                          String                       @id @default(cuid())
  businessId                  String
  userId                      String
  role                        BusinessRole
  languageCode                String?
  business                    Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  staff                       StaffMember?
  telegramIdentities          BusinessTelegramIdentity[]
  platformChatLinks           PlatformChatLink[]
  managedBotConnectionIntents ManagedBotConnectionIntent[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  @@unique([businessId, userId])
  @@index([userId])
}

model PlatformChatLink {
  id           String     @id @default(cuid())
  membershipId String
  expiresAt    DateTime
  consumedAt   DateTime?
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([membershipId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model BusinessTelegramIntegration {
  id                         String                    @id @default(cuid())
  businessId                 String
  publicId                   String                    @unique
  botId                      String
  botUsername                String
  botTokenEncrypted          String?
  webhookSecretEncrypted     String?
  status                     TelegramIntegrationStatus @default(PENDING)
  connectionMethod           TelegramConnectionMethod  @default(TOKEN)
  managedOwnerTelegramUserId String?
  managedAt                  DateTime?
  lastWebhookError           String?
  connectedByUserId          String?
  connectedAt                DateTime?
  disconnectedAt             DateTime?
  business                   Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connectedBy                User?                     @relation("TelegramIntegrationConnector", fields: [connectedByUserId], references: [id], onDelete: SetNull)
  conversations              Conversation[]
  inboundUpdates             InboundChannelUpdate[]
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  @@index([businessId, status])
  @@index([botId, status])
}

model ManagedBotConnectionIntent {
  id                  String                     @id @default(cuid())
  businessId          String
  membershipId        String
  telegramUserId      String
  suggestedUsername   String
  displayName         String
  status              ManagedBotConnectionStatus @default(PENDING)
  botId               String?
  processingStartedAt DateTime?
  expiresAt           DateTime
  completedAt         DateTime?
  lastErrorCode       String?
  business            Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership          Membership                 @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([membershipId, status, expiresAt])
  @@index([telegramUserId, status, expiresAt])
  @@index([botId])
}

model BusinessTelegramIdentity {
  id             String                 @id @default(cuid())
  membershipId   String
  telegramUserId String
  membership     Membership             @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  destinations   BusinessTelegramChat[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([membershipId, telegramUserId])
  @@index([telegramUserId])
}

model BusinessTelegramChat {
  id                     String                         @id @default(cuid())
  telegramIdentityId     String
  chatId                 String
  chatType               TelegramChatType
  active                 Boolean                        @default(true)
  linkedAt               DateTime                       @default(now())
  disabledAt             DateTime?
  telegramIdentity       BusinessTelegramIdentity       @relation(fields: [telegramIdentityId], references: [id], onDelete: Cascade)
  notificationDeliveries BusinessNotificationDelivery[]
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  @@unique([telegramIdentityId, chatId])
  @@index([chatId, active])
}

model Conversation {
  id             String                       @id @default(cuid())
  businessId     String
  integrationId  String?
  channel        ConversationChannel
  externalChatId String
  status         ConversationStatus           @default(ACTIVE)
  flowVersion    Int                          @default(1)
  business       Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  integration    BusinessTelegramIntegration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  sessions       ConversationSession[]
  actions        ConversationAction[]
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@unique([businessId, channel, externalChatId])
  @@index([integrationId])
  @@index([businessId, status])
}

model ConversationSession {
  id             String       @id @default(cuid())
  conversationId String
  state          String
  data           Json
  expiresAt      DateTime
  version        Int          @default(0)
  active         Boolean      @default(true)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId, active])
  @@index([expiresAt])
}

model ConversationAction {
  id             String       @id @default(cuid())
  businessId     String
  conversationId String
  kind           String
  payload        Json
  expiresAt      DateTime
  consumedAt     DateTime?
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([businessId, expiresAt])
  @@index([conversationId, consumedAt])
}

model InboundChannelUpdate {
  id               String                      @id @default(cuid())
  integrationId    String
  externalUpdateId String
  status           InboundUpdateStatus         @default(PROCESSING)
  attempts         Int                         @default(1)
  claimedAt        DateTime                    @default(now())
  completedAt      DateTime?
  lastError        String?
  integration      BusinessTelegramIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  receivedAt       DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@unique([integrationId, externalUpdateId])
  @@index([receivedAt])
}

model StaffMember {
  id                 String              @id @default(cuid())
  businessId         String
  membershipId       String?             @unique
  displayName        String
  phone              String?
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership         Membership?         @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  branches           StaffBranch[]
  services           Service[]
  bookings           Booking[]
  scheduleRules      StaffScheduleRule[]
  scheduleBreaks     ScheduleBreak[]
  scheduleExceptions ScheduleException[]
  commissionPercent  Int?
  commissionEntries  CommissionEntry[]
  bookingSeries      BookingSeries[]
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([businessId, archivedAt])
}

model StaffBranch {
  staffId   String
  branchId  String
  isPrimary Boolean     @default(false)
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([staffId, branchId])
  @@index([branchId])
}

model Service {
  id              String            @id @default(cuid())
  branchId        String
  name            String
  description     String?
  durationMinutes Int
  amountDiram     Int
  isPublished     Boolean           @default(false)
  archivedAt      DateTime?
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffMembers    StaffMember[]
  resources       ServiceResource[]
  bookings        Booking[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([branchId])
}

model Resource {
  id          String            @id @default(cuid())
  branchId    String
  name        String
  kind        String            @default("OTHER")
  capacity    Int               @default(1)
  isAvailable Boolean           @default(true)
  archivedAt  DateTime?
  branch      Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  services    ServiceResource[]
  bookings    BookingResource[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([branchId])
}

model Booking {
  id                    String                 @id @default(cuid())
  businessId            String
  branchId              String
  serviceId             String
  staffId               String
  customerId            String
  startsAt              DateTime
  endsAt                DateTime
  expiresAt             DateTime?
  status                BookingStatus          @default(PENDING_PAYMENT)
  source                BookingSource          @default(WEB)
  confirmedAt           DateTime?
  confirmedBy           String?
  cancelledAt           DateTime?
  cancelledBy           String?
  cancellationReason    String?
  seriesId              String?
  seriesIndex           Int?
  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch                Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service               Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff                 StaffMember            @relation(fields: [staffId], references: [id], onDelete: Restrict)
  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  series                BookingSeries?         @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  resources             BookingResource[]
  payment               Payment?
  messages              Message[]
  businessNotifications BusinessNotification[]
  auditEvents           AuditEvent[]
  review                Review?
  waitlistConversions   WaitlistEntry[]
  commissionEntry       CommissionEntry?
  promoRedemption       PromoCodeRedemption?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([businessId, branchId, startsAt, endsAt])
  @@index([staffId, startsAt, endsAt])
  @@index([status, expiresAt])
  @@index([seriesId])
}

model BookingSeries {
  id               String              @id @default(cuid())
  businessId       String
  branchId         String
  serviceId        String
  staffId          String
  customerId       String
  frequency        RecurrenceFrequency
  intervalCount    Int                 @default(1)
  occurrencesTotal Int
  status           BookingSeriesStatus @default(ACTIVE)
  createdBy        String
  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings         Booking[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  staffMember      StaffMember?        @relation(fields: [staffMemberId], references: [id])
  staffMemberId    String?

  @@index([businessId, status])
}

model WaitlistEntry {
  id                 String         @id @default(cuid())
  businessId         String
  branchId           String
  serviceId          String
  staffId            String?
  customerId         String
  desiredFrom        DateTime
  desiredTo          DateTime
  status             WaitlistStatus @default(WAITING)
  notifiedAt         DateTime?
  convertedBookingId String?        @unique
  business           Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  convertedBooking   Booking?       @relation(fields: [convertedBookingId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([businessId, branchId, serviceId, status])
  @@index([status, desiredFrom, desiredTo])
}

model CommissionEntry {
  id          String      @id @default(cuid())
  businessId  String
  staffId     String
  bookingId   String      @unique
  amountDiram Int
  percent     Int
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff       StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([businessId, staffId, createdAt])
}

model Review {
  id         String   @id @default(cuid())
  businessId String
  bookingId  String   @unique
  customerId String
  rating     Int
  comment    String?
  isHidden   Boolean  @default(false)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([businessId, isHidden, createdAt])
}

model PromoCode {
  id              String                @id @default(cuid())
  businessId      String
  code            String
  discountType    PromoDiscountType
  discountValue   Int
  maxRedemptions  Int?
  redemptionCount Int                   @default(0)
  expiresAt       DateTime?
  isActive        Boolean               @default(true)
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  redemptions     PromoCodeRedemption[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([businessId, code])
}

model PromoCodeRedemption {
  id                   String    @id @default(cuid())
  promoCodeId          String
  bookingId            String    @unique
  discountAppliedDiram Int
  promoCode            PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  booking              Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())

  @@index([promoCodeId])
}

model Message {
  id          String         @id @default(cuid())
  businessId  String
  bookingId   String
  channel     MessageChannel
  kind        String
  status      MessageStatus  @default(SCHEDULED)
  scheduledAt DateTime
  attempts    Int            @default(0)
  maxAttempts Int            @default(3)
  externalId  String?
  lastError   String?
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([bookingId, channel, kind])
  @@index([status, scheduledAt])
  @@index([externalId])
}

model BusinessNotification {
  id               String                         @id @default(cuid())
  businessId       String
  bookingId        String?
  kind             String
  deduplicationKey String
  status           MessageStatus                  @default(SCHEDULED)
  scheduledAt      DateTime
  business         Business                       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking          Booking?                       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  deliveries       BusinessNotificationDelivery[]
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  @@unique([businessId, deduplicationKey])
  @@index([status, scheduledAt])
  @@index([bookingId, kind])
}

model BusinessNotificationDelivery {
  id             String               @id @default(cuid())
  notificationId String
  destinationId  String
  status         MessageStatus        @default(SCHEDULED)
  scheduledAt    DateTime
  attempts       Int                  @default(0)
  maxAttempts    Int                  @default(3)
  lastError      String?
  notification   BusinessNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  destination    BusinessTelegramChat @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([notificationId, destinationId])
  @@index([status, scheduledAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  businessId String
  bookingId  String?
  type       String
  actorType  String
  actorId    String?
  metadata   Json
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([bookingId, createdAt])
}

model Customer {
  id             String    @id @default(cuid())
  businessId     String
  name           String
  phone          String
  telegramChatId String?
  telegramLocale String    @default("ru")
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([businessId, phone])
  @@unique([businessId, telegramChatId])
  @@index([businessId])
}

model Payment {
  id                  String              @id @default(cuid())
  businessId          String
  bookingId           String              @unique
  amountDiram         Int
  status              PaymentStatus       @default(PENDING)
  operationNumber     String?
  receiptAmountDiram  Int?
  recipientCardSuffix String?
  operationAt         DateTime?
  receiptStorageKey   String?
  receiptAcceptedAt   DateTime?
  isBankVerified      Boolean             @default(false)
  attentionReason     String?
  reviewReason        String?
  reviewedAt          DateTime?
  reviewedBy          String?
  reviewDeadline      DateTime?
  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking             Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  submissions         ReceiptSubmission[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([businessId, operationNumber])
  @@index([businessId, status])
}

model ReceiptSubmission {
  id                    String                  @id @default(cuid())
  businessId            String
  paymentId             String
  storageKey            String                  @unique
  contentType           String
  sizeBytes             Int
  status                ReceiptSubmissionStatus @default(UPLOADED)
  parsedOperationNumber String?
  parsedAmountDiram     Int?
  parsedCardSuffix      String?
  parsedOperationAt     DateTime?
  failureCode           String?
  attempts              Int                     @default(0)
  processedAt           DateTime?
  reviewedAt            DateTime?
  reviewedBy            String?
  reviewNote            String?
  business              Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payment               Payment                 @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([businessId, status, createdAt])
  @@index([paymentId, createdAt])
}

model BookingResource {
  bookingId  String
  resourceId String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@id([bookingId, resourceId])
  @@index([resourceId])
}

model ServiceResource {
  serviceId  String
  resourceId String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([serviceId, resourceId])
  @@index([resourceId])
}

model BusinessScheduleRule {
  id        String   @id @default(cuid())
  branchId  String
  dayOfWeek Int
  startsAt  String
  endsAt    String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, dayOfWeek])
}

model StaffScheduleRule {
  id        String      @id @default(cuid())
  staffId   String
  branchId  String
  dayOfWeek Int
  startsAt  String
  endsAt    String
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([staffId, branchId, dayOfWeek])
  @@index([branchId, dayOfWeek])
}

model ScheduleBreak {
  id        String       @id @default(cuid())
  branchId  String
  staffId   String?
  dayOfWeek Int
  startsAt  String
  endsAt    String
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff     StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([branchId, dayOfWeek])
  @@index([staffId, dayOfWeek])
}

model ScheduleException {
  id        String       @id @default(cuid())
  branchId  String
  staffId   String?
  startsAt  DateTime
  endsAt    DateTime
  available Boolean      @default(false)
  note      String?
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff     StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([branchId, startsAt, endsAt])
  @@index([staffId, startsAt, endsAt])
}
