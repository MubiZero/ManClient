generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessRole {
  OWNER
  ADMIN
  STAFF
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  RECEIPT_ACCEPTED
  NEEDS_ATTENTION
}

enum MessageChannel {
  TELEGRAM
  WHATSAPP
}

enum MessageStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  displayName  String
  passwordHash String?
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Business {
  id                               String       @id @default(cuid())
  name                             String
  slug                             String       @unique
  branches                         Branch[]
  memberships                      Membership[]
  bookings                         Booking[]
  customers                        Customer[]
  payments                         Payment[]
  messages                         Message[]
  auditEvents                      AuditEvent[]
  whatsappPhoneNumberId            String?
  whatsappTemplateName             String?
  whatsappConfirmationTemplateName String?
  whatsappLanguageCode             String       @default("ru")
  createdAt                        DateTime     @default(now())
  updatedAt                        DateTime     @updatedAt
}

model Branch {
  id                     String                 @id @default(cuid())
  businessId             String
  name                   String
  slug                   String
  timeZone               String                 @default("Asia/Dushanbe")
  recipientCardEncrypted String?
  recipientCardLast4     String?
  business               Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services               Service[]
  resources              Resource[]
  scheduleRules          BusinessScheduleRule[]
  staffMembers           StaffMember[]
  bookings               Booking[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([businessId, slug])
  @@index([businessId])
}

model Membership {
  id         String       @id @default(cuid())
  businessId String
  userId     String
  role       BusinessRole
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  staff      StaffMember?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([businessId, userId])
  @@index([userId])
}

model StaffMember {
  id           String     @id @default(cuid())
  branchId     String
  membershipId String     @unique
  displayName  String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  services     Service[]
  bookings     Booking[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([branchId])
}

model Service {
  id              String            @id @default(cuid())
  branchId        String
  name            String
  durationMinutes Int
  amountDiram     Int
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffMembers    StaffMember[]
  resources       ServiceResource[]
  bookings        Booking[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([branchId])
}

model Resource {
  id        String            @id @default(cuid())
  branchId  String
  name      String
  branch    Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  services  ServiceResource[]
  bookings  BookingResource[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([branchId])
}

model Booking {
  id          String            @id @default(cuid())
  businessId  String
  branchId    String
  serviceId   String
  staffId     String
  customerId  String
  startsAt    DateTime
  endsAt      DateTime
  expiresAt   DateTime
  status      BookingStatus     @default(PENDING_PAYMENT)
  cancelledAt DateTime?
  cancelledBy String?
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff       StaffMember       @relation(fields: [staffId], references: [id], onDelete: Restrict)
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  resources   BookingResource[]
  payment     Payment?
  messages    Message[]
  auditEvents AuditEvent[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([businessId, branchId, startsAt, endsAt])
  @@index([staffId, startsAt, endsAt])
  @@index([status, expiresAt])
}

model Message {
  id          String         @id @default(cuid())
  businessId  String
  bookingId   String
  channel     MessageChannel
  kind        String
  status      MessageStatus  @default(SCHEDULED)
  scheduledAt DateTime
  attempts    Int            @default(0)
  maxAttempts Int            @default(3)
  externalId  String?
  lastError   String?
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([bookingId, channel, kind])
  @@index([status, scheduledAt])
  @@index([externalId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  businessId String
  bookingId  String?
  type       String
  actorType  String
  actorId    String?
  metadata   Json
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([bookingId, createdAt])
}

model Customer {
  id             String    @id @default(cuid())
  businessId     String
  name           String
  phone          String
  telegramChatId String?
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([businessId, phone])
  @@unique([businessId, telegramChatId])
  @@index([businessId])
}

model Payment {
  id                  String        @id @default(cuid())
  businessId          String
  bookingId           String        @unique
  amountDiram         Int
  status              PaymentStatus @default(PENDING)
  operationNumber     String?
  receiptAmountDiram  Int?
  recipientCardSuffix String?
  operationAt         DateTime?
  receiptStorageKey   String?
  receiptAcceptedAt   DateTime?
  isBankVerified      Boolean       @default(false)
  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking             Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([businessId, operationNumber])
  @@index([businessId, status])
}

model BookingResource {
  bookingId  String
  resourceId String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@id([bookingId, resourceId])
  @@index([resourceId])
}

model ServiceResource {
  serviceId  String
  resourceId String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([serviceId, resourceId])
  @@index([resourceId])
}

model BusinessScheduleRule {
  id        String   @id @default(cuid())
  branchId  String
  dayOfWeek Int
  startsAt  String
  endsAt    String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, dayOfWeek])
}
