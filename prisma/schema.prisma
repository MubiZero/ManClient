generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessRole {
  OWNER
  ADMIN
  STAFF
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  /// The customer never arrived. Distinct from CANCELLED because nobody freed the slot: the specialist
  /// waited, the time was lost, and that is the difference a business needs to see in its own numbers.
  NO_SHOW
}

enum BookingSource {
  WEB
  TELEGRAM
  DASHBOARD
}

enum PaymentStatus {
  PENDING
  RECEIPT_PROCESSING
  RECEIPT_ACCEPTED
  NEEDS_ATTENTION
  REJECTED
  /// Nothing was due before the visit: the business takes payment on the premises. The row still exists
  /// so the price of the visit is recorded and every query that joins a booking to its payment holds.
  NOT_REQUIRED
}

/// What a customer must transfer before a slot is held for them.
enum PrepaymentMode {
  /// The whole price, or the reservation expires. The behaviour that predates this setting.
  FULL
  /// Part of the price, by percentage or as a fixed sum; the rest is paid at the visit.
  DEPOSIT
  /// Nothing. The booking is confirmed the moment it is made and paid for on the premises.
  NONE
}

enum ReceiptSubmissionStatus {
  UPLOADED
  PROCESSING
  ACCEPTED
  NEEDS_REVIEW
  REJECTED
  FAILED
}

enum MessageChannel {
  TELEGRAM
  WHATSAPP
  SMS
}

enum SubscriptionPlan {
  START
  STANDARD
  PREMIUM
}

/// Whether the sold plan is currently in force. The plan itself says what was sold; this says
/// whether it still applies. `GRACE` deliberately keeps every paid feature switched on — it is a
/// warning, not a punishment.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  GRACE
  EXPIRED
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum BookingSeriesStatus {
  ACTIVE
  CANCELLED
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  CONVERTED
  CANCELLED
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

enum MessageStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum TelegramIntegrationStatus {
  PENDING
  ACTIVE
  ERROR
  DISCONNECTED
}

enum TelegramConnectionMethod {
  TOKEN
  MANAGED
}

enum ManagedBotConnectionStatus {
  PENDING
  PROCESSING
  COMPLETED
  EXPIRED
  FAILED
}

enum TelegramChatType {
  PRIVATE
  GROUP
  SUPERGROUP
  CHANNEL
}

enum ConversationStatus {
  ACTIVE
  WAITING_FOR_OPERATOR
  CLOSED
}

enum ConversationChannel {
  TELEGRAM
  WHATSAPP
  WEB
}

enum InboundUpdateStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                            String                        @id @default(cuid())
  email                         String?                       @unique
  phone                         String?                       @unique
  displayName                   String
  passwordHash                  String?
  isPlatformAdmin               Boolean                       @default(false)
  memberships                   Membership[]
  connectedTelegramIntegrations BusinessTelegramIntegration[] @relation("TelegramIntegrationConnector")
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

model Business {
  id                               String                        @id @default(cuid())
  status                           BusinessStatus                @default(ACTIVE)
  name                             String
  slug                             String                        @unique
  branches                         Branch[]
  memberships                      Membership[]
  staffMembers                     StaffMember[]
  bookings                         Booking[]
  customers                        Customer[]
  payments                         Payment[]
  subscriptionInvoices             SubscriptionInvoice[]
  receiptSubmissions               ReceiptSubmission[]
  messages                         Message[]
  businessNotifications            BusinessNotification[]
  auditEvents                      AuditEvent[]
  telegramIntegrations             BusinessTelegramIntegration[]
  managedBotConnectionIntents      ManagedBotConnectionIntent[]
  conversations                    Conversation[]
  conversationActions              ConversationAction[]
  whatsappPhoneNumberId            String?
  whatsappTemplateName             String?
  whatsappConfirmationTemplateName String?
  whatsappCancellationTemplateName String?
  whatsappLanguageCode             String                        @default("ru")
  logoStorageKey                   String?
  brandColor                       String?
  notifyOnNewBooking               Boolean                       @default(true)
  notifyOnPaymentNeedsReview       Boolean                       @default(true)
  notifyOnCancellation             Boolean                       @default(true)
  cancellationPolicy               String?
  /// How much notice a customer must give to book at all. Zero keeps same-minute booking, which is
  /// what every existing business had before these fields existed.
  minLeadTimeMinutes               Int                           @default(0)
  /// How far ahead a customer may book. Null means no horizon — the pre-policy behaviour.
  maxAdvanceDays                   Int?
  /// Hours before the visit during which a customer may still cancel or reschedule it themselves.
  /// Zero means always, which is the pre-policy behaviour. Staff are never bound by it.
  freeCancellationHours            Int                           @default(0)
  /// How many times one booking may be moved by the customer. Null means unlimited.
  maxCustomerReschedules           Int?
  /// How much of the price a customer must transfer before the slot is theirs. FULL is what every
  /// business had before deposits existed: the whole price up front, or the reservation expires.
  prepaymentMode                   PrepaymentMode                @default(FULL)
  /// Share of the price taken as a deposit, 1–100. Ignored when `depositAmountDiram` is set.
  depositPercent                   Int?
  /// Fixed deposit in diram. Wins over the percentage, and is capped at the price of the visit.
  depositAmountDiram               Int?
  subscriptionPlan                 SubscriptionPlan              @default(START)
  subscriptionStatus               SubscriptionStatus            @default(ACTIVE)
  /// Paid through this moment. Null means no expiry at all, which is what every business had before
  /// billing existed and what a manual grant by a platform admin still means. The lifecycle job must
  /// never touch a null.
  subscriptionEndsAt               DateTime?
  smsNotificationsEnabled          Boolean                       @default(false)
  defaultCommissionPercent         Int?
  publicPageLocale                 String                        @default("ru")
  bookingSeries                    BookingSeries[]
  waitlistEntries                  WaitlistEntry[]
  commissionEntries                CommissionEntry[]
  reviews                          Review[]
  promoCodes                       PromoCode[]
  createdAt                        DateTime                      @default(now())
  updatedAt                        DateTime                      @updatedAt
}

model Branch {
  id                     String                 @id @default(cuid())
  businessId             String
  name                   String
  slug                   String
  address                String?
  phone                  String?
  timeZone               String                 @default("Asia/Dushanbe")
  recipientCardEncrypted String?
  recipientCardLast4     String?
  business               Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services               Service[]
  resources              Resource[]
  scheduleRules          BusinessScheduleRule[]
  staffAssignments       StaffBranch[]
  staffScheduleRules     StaffScheduleRule[]
  scheduleBreaks         ScheduleBreak[]
  scheduleExceptions     ScheduleException[]
  bookings               Booking[]
  bookingSeries          BookingSeries[]
  waitlistEntries        WaitlistEntry[]
  archivedAt             DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([businessId, slug])
  @@index([businessId])
}

model Membership {
  id                          String                       @id @default(cuid())
  businessId                  String
  userId                      String
  role                        BusinessRole
  languageCode                String?
  business                    Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  staff                       StaffMember?
  telegramIdentities          BusinessTelegramIdentity[]
  platformChatLinks           PlatformChatLink[]
  managedBotConnectionIntents ManagedBotConnectionIntent[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  @@unique([businessId, userId])
  @@index([userId])
}

model PlatformChatLink {
  id           String     @id @default(cuid())
  membershipId String
  expiresAt    DateTime
  consumedAt   DateTime?
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([membershipId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model BusinessTelegramIntegration {
  id                         String                    @id @default(cuid())
  businessId                 String
  publicId                   String                    @unique
  botId                      String
  botUsername                String
  botTokenEncrypted          String?
  webhookSecretEncrypted     String?
  status                     TelegramIntegrationStatus @default(PENDING)
  connectionMethod           TelegramConnectionMethod  @default(TOKEN)
  managedOwnerTelegramUserId String?
  managedAt                  DateTime?
  lastWebhookError           String?
  connectedByUserId          String?
  connectedAt                DateTime?
  disconnectedAt             DateTime?
  business                   Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connectedBy                User?                     @relation("TelegramIntegrationConnector", fields: [connectedByUserId], references: [id], onDelete: SetNull)
  conversations              Conversation[]
  inboundUpdates             InboundChannelUpdate[]
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  @@index([businessId, status])
  @@index([botId, status])
}

model ManagedBotConnectionIntent {
  id                  String                     @id @default(cuid())
  businessId          String
  membershipId        String
  telegramUserId      String
  suggestedUsername   String
  displayName         String
  status              ManagedBotConnectionStatus @default(PENDING)
  botId               String?
  processingStartedAt DateTime?
  expiresAt           DateTime
  completedAt         DateTime?
  lastErrorCode       String?
  business            Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership          Membership                 @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([membershipId, status, expiresAt])
  @@index([telegramUserId, status, expiresAt])
  @@index([botId])
}

model BusinessTelegramIdentity {
  id             String                 @id @default(cuid())
  membershipId   String
  telegramUserId String
  membership     Membership             @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  destinations   BusinessTelegramChat[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([membershipId, telegramUserId])
  @@index([telegramUserId])
}

model BusinessTelegramChat {
  id                     String                         @id @default(cuid())
  telegramIdentityId     String
  chatId                 String
  chatType               TelegramChatType
  active                 Boolean                        @default(true)
  linkedAt               DateTime                       @default(now())
  disabledAt             DateTime?
  telegramIdentity       BusinessTelegramIdentity       @relation(fields: [telegramIdentityId], references: [id], onDelete: Cascade)
  notificationDeliveries BusinessNotificationDelivery[]
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  @@unique([telegramIdentityId, chatId])
  @@index([chatId, active])
}

model Conversation {
  id             String                       @id @default(cuid())
  businessId     String
  integrationId  String?
  channel        ConversationChannel
  externalChatId String
  status         ConversationStatus           @default(ACTIVE)
  flowVersion    Int                          @default(1)
  business       Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  integration    BusinessTelegramIntegration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  sessions       ConversationSession[]
  actions        ConversationAction[]
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@unique([businessId, channel, externalChatId])
  @@index([integrationId])
  @@index([businessId, status])
}

model ConversationSession {
  id             String       @id @default(cuid())
  conversationId String
  state          String
  data           Json
  expiresAt      DateTime
  version        Int          @default(0)
  active         Boolean      @default(true)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId, active])
  @@index([expiresAt])
}

model ConversationAction {
  id             String       @id @default(cuid())
  businessId     String
  conversationId String
  kind           String
  payload        Json
  expiresAt      DateTime
  consumedAt     DateTime?
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([businessId, expiresAt])
  @@index([conversationId, consumedAt])
}

model InboundChannelUpdate {
  id               String                      @id @default(cuid())
  integrationId    String
  externalUpdateId String
  status           InboundUpdateStatus         @default(PROCESSING)
  attempts         Int                         @default(1)
  claimedAt        DateTime                    @default(now())
  completedAt      DateTime?
  lastError        String?
  integration      BusinessTelegramIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  receivedAt       DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@unique([integrationId, externalUpdateId])
  @@index([receivedAt])
}

model StaffMember {
  id                 String              @id @default(cuid())
  businessId         String
  membershipId       String?             @unique
  displayName        String
  phone              String?
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership         Membership?         @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  branches           StaffBranch[]
  services           Service[]
  bookings           Booking[]
  scheduleRules      StaffScheduleRule[]
  scheduleBreaks     ScheduleBreak[]
  scheduleExceptions ScheduleException[]
  commissionPercent  Int?
  commissionEntries  CommissionEntry[]
  bookingSeries      BookingSeries[]
  waitlistEntries    WaitlistEntry[]
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([businessId, archivedAt])
}

model StaffBranch {
  staffId   String
  branchId  String
  isPrimary Boolean     @default(false)
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([staffId, branchId])
  @@index([branchId])
}

model Service {
  id              String            @id @default(cuid())
  branchId        String
  name            String
  description     String?
  durationMinutes Int
  /// Minutes of the specialist's and resources' time this service blocks before and after the visit
  /// itself — setup, cleaning, a car leaving the box. Not shown to the customer as bookable time and
  /// not charged; the slot simply stops being offered to anyone else.
  bufferBeforeMinutes Int            @default(0)
  bufferAfterMinutes  Int            @default(0)
  amountDiram     Int
  /// Overrides the business's prepayment rule for this service alone — the reason deposits exist is that
  /// an expensive, long service is the one worth protecting, while a fringe trim is not. Null follows
  /// the business, and the two deposit fields are read only when this one is set.
  prepaymentMode     PrepaymentMode?
  depositPercent     Int?
  depositAmountDiram Int?
  isPublished     Boolean           @default(false)
  archivedAt      DateTime?
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffMembers    StaffMember[]
  resources       ServiceResource[]
  bookings        Booking[]
  bookingSeries   BookingSeries[]
  waitlistEntries WaitlistEntry[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([branchId])
}

model Resource {
  id          String            @id @default(cuid())
  branchId    String
  name        String
  kind        String            @default("OTHER")
  capacity    Int               @default(1)
  isAvailable Boolean           @default(true)
  archivedAt  DateTime?
  branch      Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  services    ServiceResource[]
  bookings    BookingResource[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([branchId])
}

model Booking {
  id                    String                 @id @default(cuid())
  businessId            String
  branchId              String
  serviceId             String
  staffId               String
  customerId            String
  startsAt              DateTime
  endsAt                DateTime
  expiresAt             DateTime?
  status                BookingStatus          @default(PENDING_PAYMENT)
  source                BookingSource          @default(WEB)
  confirmedAt           DateTime?
  confirmedBy           String?
  cancelledAt           DateTime?
  cancelledBy           String?
  cancellationReason    String?
  seriesId              String?
  seriesIndex           Int?
  /// Customer-initiated moves only, so a business rearranging its own day never exhausts the limit.
  rescheduleCount       Int                    @default(0)
  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch                Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service               Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff                 StaffMember            @relation(fields: [staffId], references: [id], onDelete: Restrict)
  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  series                BookingSeries?         @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  resources             BookingResource[]
  payment               Payment?
  messages              Message[]
  businessNotifications BusinessNotification[]
  auditEvents           AuditEvent[]
  review                Review?
  waitlistConversions   WaitlistEntry[]
  commissionEntry       CommissionEntry?
  promoRedemption       PromoCodeRedemption?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([businessId, branchId, startsAt, endsAt])
  @@index([staffId, startsAt, endsAt])
  @@index([status, expiresAt])
  @@index([seriesId])
}

model BookingSeries {
  id               String              @id @default(cuid())
  businessId       String
  branchId         String
  serviceId        String
  staffId          String
  customerId       String
  frequency        RecurrenceFrequency
  intervalCount    Int                 @default(1)
  occurrencesTotal Int
  status           BookingSeriesStatus @default(ACTIVE)
  createdBy        String
  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service          Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff            StaffMember         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customer         Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings         Booking[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([businessId, status])
}

model WaitlistEntry {
  id                 String         @id @default(cuid())
  businessId         String
  branchId           String
  serviceId          String
  staffId            String?
  customerId         String
  desiredFrom        DateTime
  desiredTo          DateTime
  status             WaitlistStatus @default(WAITING)
  notifiedAt         DateTime?
  // The slot that came free, captured when the entry is notified. Without it the outgoing message
  // cannot name a time, and the SMS template has nowhere to read {date-1}/{time-1} from.
  freedStartsAt      DateTime?
  convertedBookingId String?        @unique
  business           Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch             Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service            Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff              StaffMember?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  customer           Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  convertedBooking   Booking?       @relation(fields: [convertedBookingId], references: [id], onDelete: SetNull)
  messages           Message[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([businessId, branchId, serviceId, status])
  @@index([status, desiredFrom, desiredTo])
}

model CommissionEntry {
  id          String      @id @default(cuid())
  businessId  String
  staffId     String
  bookingId   String      @unique
  amountDiram Int
  percent     Int
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff       StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([businessId, staffId, createdAt])
}

model Review {
  id         String   @id @default(cuid())
  businessId String
  bookingId  String   @unique
  customerId String
  rating     Int
  comment    String?
  isHidden   Boolean  @default(false)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([businessId, isHidden, createdAt])
}

model PromoCode {
  id              String                @id @default(cuid())
  businessId      String
  code            String
  discountType    PromoDiscountType
  discountValue   Int
  maxRedemptions  Int?
  redemptionCount Int                   @default(0)
  expiresAt       DateTime?
  isActive        Boolean               @default(true)
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  redemptions     PromoCodeRedemption[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([businessId, code])
}

model PromoCodeRedemption {
  id                   String    @id @default(cuid())
  promoCodeId          String
  bookingId            String    @unique
  discountAppliedDiram Int
  promoCode            PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  booking              Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())

  @@index([promoCodeId])
}

/// Outbound customer message queue. Exactly one of bookingId / waitlistEntryId is set: most
/// messages hang off a booking, but a freed-slot alert belongs to a waitlist entry and has no
/// booking to point at.
model Message {
  id              String         @id @default(cuid())
  businessId      String
  bookingId       String?
  waitlistEntryId String?
  channel         MessageChannel
  kind            String
  status          MessageStatus  @default(SCHEDULED)
  scheduledAt     DateTime
  attempts        Int            @default(0)
  maxAttempts     Int            @default(3)
  externalId      String?
  lastError       String?
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking         Booking?       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  waitlistEntry   WaitlistEntry? @relation(fields: [waitlistEntryId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([bookingId, channel, kind])
  @@unique([waitlistEntryId, channel, kind])
  @@index([status, scheduledAt])
  @@index([externalId])
}

model BusinessNotification {
  id               String                         @id @default(cuid())
  businessId       String
  bookingId        String?
  kind             String
  deduplicationKey String
  status           MessageStatus                  @default(SCHEDULED)
  scheduledAt      DateTime
  business         Business                       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking          Booking?                       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  deliveries       BusinessNotificationDelivery[]
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  @@unique([businessId, deduplicationKey])
  @@index([status, scheduledAt])
  @@index([bookingId, kind])
}

model BusinessNotificationDelivery {
  id             String               @id @default(cuid())
  notificationId String
  destinationId  String
  status         MessageStatus        @default(SCHEDULED)
  scheduledAt    DateTime
  attempts       Int                  @default(0)
  maxAttempts    Int                  @default(3)
  lastError      String?
  notification   BusinessNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  destination    BusinessTelegramChat @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([notificationId, destinationId])
  @@index([status, scheduledAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  /// Null for platform-wide events — changing what a plan costs belongs to no single salon. Every
  /// business-scoped event still carries its business, and `writeAuditEvent` still demands one.
  businessId String?
  bookingId  String?
  type       String
  actorType  String
  actorId    String?
  metadata   Json
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([bookingId, createdAt])
}

/// What a plan costs, one row per plan and period. A plan with no row is not sold at all — that is
/// how a plan is taken off the shelf without deleting anyone's subscription to it.
model PlanPrice {
  id          String           @id @default(cuid())
  plan        SubscriptionPlan
  period      BillingPeriod
  amountDiram Int
  /// The platform admin who last set it, for the screen that has to say who changed the price.
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([plan, period])
}

enum SubscriptionInvoiceStatus {
  OPEN
  NEEDS_ATTENTION
  PAID
  CANCELLED
}

/// A bill for one subscription period. `amountDiram` is a snapshot, not a lookup: re-pricing a plan
/// tomorrow must not silently change what a business was asked to pay today.
model SubscriptionInvoice {
  id          String                    @id @default(cuid())
  businessId  String
  plan        SubscriptionPlan
  period      BillingPeriod
  amountDiram Int
  status      SubscriptionInvoiceStatus @default(OPEN)
  /// Short human-readable number. It travels in the payment link and is what the operator matches a
  /// transfer against, so it is unique and never reused.
  reference   String                    @unique
  paidAt      DateTime?
  business    Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([businessId, status])
  @@index([status, createdAt])
}

model Customer {
  id              String          @id @default(cuid())
  businessId      String
  name            String
  phone           String
  telegramChatId  String?
  telegramLocale  String          @default("ru")
  /// How many times this customer has failed to turn up. Kept on the customer rather than counted on
  /// demand so the number survives the bookings being archived, and so a receptionist can see it while
  /// deciding whether to ask this one for a deposit.
  noShowCount     Int             @default(0)
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  bookingSeries   BookingSeries[]
  waitlistEntries WaitlistEntry[]
  reviews         Review[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([businessId, phone])
  @@unique([businessId, telegramChatId])
  @@index([businessId])
}

model Payment {
  id                  String              @id @default(cuid())
  businessId          String
  bookingId           String              @unique
  /// What the customer had to transfer before the visit — the whole price, a deposit, or nothing.
  /// The receipt is matched against this, so it must stay the amount that was actually asked for.
  amountDiram         Int
  /// The price of the visit after discounts. Equal to `amountDiram` unless a deposit was taken, in which
  /// case the difference is what the business still collects on the premises.
  totalDiram          Int                 @default(0)
  status              PaymentStatus       @default(PENDING)
  operationNumber     String?
  receiptAmountDiram  Int?
  recipientCardSuffix String?
  operationAt         DateTime?
  receiptStorageKey   String?
  receiptAcceptedAt   DateTime?
  /// When money that had already arrived was kept because the customer did not come. This is what a
  /// deposit is for, and recording it is what lets a business answer "was I compensated for that hour".
  forfeitedAt         DateTime?
  isBankVerified      Boolean             @default(false)
  attentionReason     String?
  reviewReason        String?
  reviewedAt          DateTime?
  reviewedBy          String?
  reviewDeadline      DateTime?
  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking             Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  submissions         ReceiptSubmission[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([businessId, operationNumber])
  @@index([businessId, status])
}

model ReceiptSubmission {
  id                    String                  @id @default(cuid())
  businessId            String
  paymentId             String
  storageKey            String                  @unique
  contentType           String
  sizeBytes             Int
  status                ReceiptSubmissionStatus @default(UPLOADED)
  parsedOperationNumber String?
  parsedAmountDiram     Int?
  parsedCardSuffix      String?
  parsedOperationAt     DateTime?
  failureCode           String?
  attempts              Int                     @default(0)
  processedAt           DateTime?
  reviewedAt            DateTime?
  reviewedBy            String?
  reviewNote            String?
  business              Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payment               Payment                 @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([businessId, status, createdAt])
  @@index([paymentId, createdAt])
}

model BookingResource {
  bookingId  String
  resourceId String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@id([bookingId, resourceId])
  @@index([resourceId])
}

model ServiceResource {
  serviceId  String
  resourceId String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([serviceId, resourceId])
  @@index([resourceId])
}

model BusinessScheduleRule {
  id        String   @id @default(cuid())
  branchId  String
  dayOfWeek Int
  startsAt  String
  endsAt    String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, dayOfWeek])
}

model StaffScheduleRule {
  id        String      @id @default(cuid())
  staffId   String
  branchId  String
  dayOfWeek Int
  startsAt  String
  endsAt    String
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([staffId, branchId, dayOfWeek])
  @@index([branchId, dayOfWeek])
}

model ScheduleBreak {
  id        String       @id @default(cuid())
  branchId  String
  staffId   String?
  dayOfWeek Int
  startsAt  String
  endsAt    String
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff     StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([branchId, dayOfWeek])
  @@index([staffId, dayOfWeek])
}

model ScheduleException {
  id        String       @id @default(cuid())
  branchId  String
  staffId   String?
  startsAt  DateTime
  endsAt    DateTime
  available Boolean      @default(false)
  note      String?
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff     StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([branchId, startsAt, endsAt])
  @@index([staffId, startsAt, endsAt])
}

/**
 * Fixed-window request counters. Postgres rather than Redis because the platform already depends on
 * Postgres being up, and a limiter that needs a second datastore to work is a limiter that is off
 * during the incident it exists for. One row per (scope, subject, window); rows are deleted by the
 * expiry job rather than kept for analytics.
 */
model RateLimitCounter {
  id             String   @id @default(cuid())
  scope          String
  subject        String
  windowStartsAt DateTime
  count          Int      @default(0)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([scope, subject, windowStartsAt])
  @@index([expiresAt])
}

enum PhoneVerificationPurpose {
  BOOKING
  PASSWORD_RESET
}

enum PhoneVerificationStatus {
  PENDING
  VERIFIED
  CONSUMED
  EXPIRED
}

/**
 * A one-time code sent over SMS. Two flows share it: proving that whoever is booking controls the
 * phone number they typed, and letting a business owner back into an account whose password is gone.
 *
 * The code itself is never stored — only a hash — because this table is inside the same database an
 * SQL injection or a leaked dump would expose, and a plaintext code is a live session.
 */
model PhoneVerification {
  id          String                   @id @default(cuid())
  phone       String
  purpose     PhoneVerificationPurpose
  codeHash    String
  status      PhoneVerificationStatus  @default(PENDING)
  attempts    Int                      @default(0)
  maxAttempts Int                      @default(5)
  expiresAt   DateTime
  lastSentAt  DateTime
  verifiedAt  DateTime?
  consumedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([phone, purpose, status])
  @@index([status, expiresAt])
}
