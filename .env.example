DATABASE_URL="postgresql://manclient:manclient@localhost:5432/manclient"
DATABASE_DIRECT_URL="postgresql://manclient:manclient@localhost:5432/manclient"
AUTH_SECRET="replace-with-a-random-32-byte-value"
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
CARD_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"
INTEGRATION_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"
INTERNAL_API_SECRET="replace-with-a-random-32-byte-value"
BOOKING_ACTION_SECRET="replace-with-a-random-32-byte-value"
PLATFORM_LINK_SECRET="replace-with-a-random-32-byte-value"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="manclient-receipts"
S3_ACCESS_KEY_ID="replace-for-local-minio"
S3_SECRET_ACCESS_KEY="replace-for-local-minio"
# Platform bot credentials (@manclient_bot), not customer bot credentials.
# Enable Bot Management Mode for this bot in @BotFather.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
# Optional: chat id (platform admin's private chat with @manclient_bot) that
# receives alerts about integrations in ERROR status or businesses with a
# backlog of FAILED messages. Leave empty to disable admin alerting.
PLATFORM_ADMIN_ALERT_CHAT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_GRAPH_API_VERSION="v23.0"
WHATSAPP_TEMPLATE_ALLOWLIST="booking_confirmed,booking_reminder"
# payom.tj SMS gateway. Token is issued in the payom.tj dashboard under
# "Настройки API"; senderName must be a pre-registered sender name.
# Leave PAYOM_API_TOKEN empty to disable SMS delivery entirely.
PAYOM_API_BASE_URL="https://gateway.payom.tj"
PAYOM_API_TOKEN=""
PAYOM_SENDER_NAME=""
DEMO_OWNER_PASSWORD=""
DEMO_STAFF_PASSWORD=""
DEMO_AUTO_OWNER_PASSWORD=""
