  "name": "manclient",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "next dev",
    "build": "next build",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:rotate-card-key": "tsx scripts/rotate-card-encryption-key.ts",
    "icons:generate": "tsx scripts/generate-app-icons.ts",
    "platform:grant-admin": "tsx scripts/grant-platform-admin.ts",
    "jobs:expire": "tsx src/jobs/run-expiry.ts",
    "jobs:reminders": "tsx src/jobs/run-reminders.ts",
    "jobs:receipts": "tsx src/jobs/run-receipt-processing.ts",
    "jobs:business-notifications": "tsx src/jobs/run-business-notifications.ts",
    "jobs:subscriptions": "tsx src/jobs/run-subscription-lifecycle.ts",
    "jobs:scheduler": "tsx src/jobs/scheduler.ts",
    "telegram:register-platform-webhook": "tsx scripts/register-platform-telegram-webhook.ts",
    "deploy:coolify": "tsx scripts/deploy-to-coolify.ts",
    "probe:https": "tsx scripts/probe-https.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism --maxWorkers=1",
    "test:integration": "vitest run tests/integration --no-file-parallelism --maxWorkers=1",
    "test:e2e": "playwright test"
  },
